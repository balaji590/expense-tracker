# Copy this file to .env and fill in real values for your local setup.
# .env is gitignored and must NEVER be committed.

NODE_ENV=development
PORT=3001

# PostgreSQL connection. Never commit real credentials.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expensetracker_dev
DB_USER=expensetracker
DB_PASSWORD=changeme

# Used only by `npm test` — point this at a separate database so tests
# never run against (and never risk truncating) development data.
TEST_DB_NAME=expensetracker_test

# CORS: the exact origin(s) the frontend is served from. Comma-separated
# for multiple origins. Never use "*" once cookies/sessions exist.
# In production this MUST be set explicitly — there is no localhost fallback.
CORS_ORIGIN=http://localhost:8080

# --- Authentication (Phase 5.2: magic link + server sessions) ---

# How long a requested magic link stays valid before it expires, in minutes.
AUTH_MAGIC_LINK_TTL_MINUTES=15

# How long a session stays valid (from creation) before it expires, in days.
AUTH_SESSION_TTL_DAYS=30

# 'development' | 'production'. In 'development' mode ONLY, the magic-link
# request response includes a devMagicLink field so you can test the flow
# without a real email provider. This is double-gated in code (also requires
# NODE_ENV !== 'production'), but never set this to 'development' in a real
# deployment regardless.
AUTH_EMAIL_MODE=development

# Base URL used to build the dev-mode magic link (e.g. http://localhost:3001).
# Irrelevant once AUTH_EMAIL_MODE=production and a real email provider exists.
AUTH_DEV_BASE_URL=http://localhost:3001

# Name of the session cookie.
AUTH_COOKIE_NAME=et_session

# Whether the session cookie requires HTTPS (the 'Secure' cookie attribute).
# Defaults to true automatically when NODE_ENV=production; only set this
# explicitly if you need to override that default (e.g. testing HTTPS locally).
# AUTH_COOKIE_SECURE=true
